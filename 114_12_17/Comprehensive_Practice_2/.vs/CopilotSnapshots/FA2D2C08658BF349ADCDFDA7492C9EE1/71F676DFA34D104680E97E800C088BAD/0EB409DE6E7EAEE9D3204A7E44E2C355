using System;
using System.Collections.Generic;
using System.ComponentModel;
using System.Data;
using System.Drawing;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
using System.Windows.Forms;

namespace Comprehensive_Practice_1
{
    public partial class Form1 : Form
    {
        public Form1()
        {
            InitializeComponent();
        }

        private void btnShowMax_Click(object sender, EventArgs e)
        {
            // Parse quiz scores
            if (!double.TryParse(txtQuiz1.Text, out double q1))
            {
                MessageBox.Show("請輸入小考1的數字成績", "輸入錯誤", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }
            if (!double.TryParse(txtQuiz2.Text, out double q2))
            {
                MessageBox.Show("請輸入小考2的數字成績", "輸入錯誤", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }
            if (!double.TryParse(txtQuiz3.Text, out double q3))
            {
                MessageBox.Show("請輸入小考3的數字成績", "輸入錯誤", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            double max = Math.Max(q1, Math.Max(q2, q3));
            lblResult.Text = $"{txtLastName.Text}{txtFirstName.Text} 的最高分: {max}";
        }

        private void btnExit_Click(object sender, EventArgs e)
        {
            this.Close();
        }
    }
}
